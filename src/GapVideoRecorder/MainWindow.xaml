<Window x:Class="GapVideoRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GAP Video Recorder" Icon="/assets/app-icon.ico" Height="800" Width="1280" MinHeight="600" MinWidth="900"
        Background="#171A1E" Foreground="White" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0">
      <TextBlock Text="CAMERAS" FontWeight="Bold" Margin="0,0,0,8"/>
      <ListBox x:Name="CameraList" Background="#22262C" BorderBrush="#404751" Foreground="White"
               PreviewMouseMove="CameraList_PreviewMouseMove" MouseDoubleClick="CameraList_MouseDoubleClick"
               DisplayMemberPath="DisplayName" MinHeight="250"/>
      <TextBlock Margin="0,12,0,0" Foreground="#A7AEB7" FontSize="12" TextWrapping="Wrap"
                 Text="Drag a camera onto the canvas. Drag a camera tile to move it. Drag any blue corner handle to resize it. A tile may extend outside the canvas to record only part of it. Select a tile and press Delete to remove it."/>
    </StackPanel>

    <Border Grid.Row="0" Grid.Column="2" Background="#090A0C" BorderBrush="#30353D" BorderThickness="1" CornerRadius="4"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <Viewbox Stretch="Uniform">
        <Canvas x:Name="OutputCanvas" Width="1920" Height="1080" Background="Black" ClipToBounds="True" AllowDrop="True"
                Drop="OutputCanvas_Drop" DragOver="OutputCanvas_DragOver" KeyDown="OutputCanvas_KeyDown" Focusable="True"/>
      </Viewbox>
    </Border>

    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Recording size" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="ResolutionBox" Grid.Column="1" Width="180" SelectedIndex="0" SelectionChanged="ResolutionBox_SelectionChanged">
        <ComboBoxItem Content="1080p · 1920 × 1080" Tag="1920,1080"/>
        <ComboBoxItem Content="2K · 2560 × 1440" Tag="2560,1440"/>
        <ComboBoxItem Content="4K · 3840 × 2160" Tag="3840,2160"/>
      </ComboBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Quality" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <Slider x:Name="QualitySlider" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Width="105" VerticalAlignment="Center" ValueChanged="QualitySlider_ValueChanged"/>
        <TextBlock x:Name="QualityText" Text="Balanced" Foreground="#C8D0D8" VerticalAlignment="Center" Margin="7,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="TimerText" Grid.Column="4" Text="00:00:00" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="RecordButton" Style="{StaticResource ActionButton}" Content="●  Record" Background="#BA3541" Click="RecordButton_Click"/>
        <Button x:Name="StopButton" Style="{StaticResource ActionButton}" Content="■  Stop" IsEnabled="False" Background="#3E454D" Click="StopButton_Click"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Foreground="#C8D0D8"
               Text="Ready · H.264 MP4 · no audio · saves to Videos"/>
  </Grid>
</Window>
